<div class="form-row">

    <div class="form-item">
        <label>mpn</label>
        <input type="text" name="mpn" value="<%= product.mpn %>">
    </div>
    
    <div class="form-item">
        <label>Item Number</label>
        <input type="text" name="itemNumber" value="<%= product.itemNumber %>">
    </div>

</div>
<div class="form-row">
    <div class="form-item">
        <label>Description</label>
        <input type="text" name="description" value="<%= product.description %>">
      
    </div>
    <div class="form-item">
        <label>Price</label>
        <input type="text" name="price" value="<%= product.price %>">
    </div>
</div>
<div class="form-row">
    <div class="form-item">
        <label>CRV Tier</label>
        <select name="crvTier">
            <option value="" <%= !product.crvTier ? 'selected' : '' %>>None</option>
            <option value="low" <%= product.crvTier === 'low' ? 'selected' : '' %>>Low ($0.05)</option>
            <option value="high" <%= product.crvTier === 'high' ? 'selected' : '' %>>High ($0.10)</option>
        </select>
    </div>
    <div class="form-item">
        <label>Unit Count</label>
        <input type="text" name="unitCount" value="<%= product.unitCount || '' %>" placeholder="e.g. 24">
    </div>
</div>