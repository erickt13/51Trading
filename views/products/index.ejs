<h2 class="page-header">Search Products</h2>
<form action="/products" method="GET">
    <div class="form-row">
        <div class="form-item">
            <label>Product</label>
            <input type="text" name="search" value= "<%= searchOptions.search || '' %>" >
        </div>
    </div>
   <div class="form-row form-row-end">
    <button class="btn btn-primary" type="submit">Search</button>
   </div>
</form>
<br>
<div id="productList">
    <table class="table-striped">
        <thead>
            <th>Item Number</th>
            <th>Description</th>
            <th>CRV</th>
            <th>Unit Count</th>
            <th>MPN</th>
            <th>Price</th>
            <th>Actions</th>
        </thead>
        <tbody>
            <% products.forEach(product => { %>
    <tr>
        <td><%= product.itemNumber %></td>
        <td><%= product.description %></td>
        <% if (product.crvTier === 'low') { %>
            <td>Low (0.05)</td>
        <% } else if (product.crvTier === 'high') { %>
            <td>High (0.10)</td>
        <% } else { %>
            <td>—</td>
        <% } %>
        <td><%= product.unitCount || '' %></td>
        <td><%= product.mpn %></td>
        <td>$<%= product.price %></td>
        <td><div class="btn-row no-margin">
            <a class="btn btn-primary" href="/products/<%= product.id %>">View</a>
            <a class="btn btn-primary" href="/products/<%= product.id %>/edit">Edit</a>
            <%- include('../partials/deleteForm', { url: `/products/${product.id}` }) %>
        </div></td>
    </tr>
<% }) %>
        </tbody>
    </table>
</div>



<div class="pagination">
    <% if (currentPage > 1) { %>
        <a href="?search=<%= searchOptions.search || '' %>&page=<%= currentPage - 1 %>" class="btn btn-primary">Previous</a>
    <% } %>

    <span>Page <%= currentPage %> of <%= totalPages %></span>

    <% if (currentPage < totalPages) { %>
        <a href="?search=<%= searchOptions.search || '' %>&page=<%= currentPage + 1 %>" class="btn btn-primary">Next</a>
    <% } %>
</div>